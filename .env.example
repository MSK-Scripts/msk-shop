# Tebex Headless API
NEXT_PUBLIC_TEBEX_PUBLIC_TOKEN=your_public_token
NEXT_PUBLIC_TEBEX_PROJECT_ID=your_project_id

# Private key — NEVER expose this in client-side code
TEBEX_PRIVATE_KEY=your_private_key

# Base URL
NEXT_PUBLIC_BASE_URL=https://www.msk-scripts.de

# ── Database (MariaDB/MySQL) ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD='your_db_password'
DB_NAME=your_db_name

# ── Giveaway Bot Database (read-only) ─────────────────────────────────────────
# The Giveaway Bot stores its data in its OWN MariaDB database (giveaway_bot,
# Prisma-managed). The public /giveaway/stats page reads aggregate, anonymous
# numbers from it via a dedicated, least-privilege READ-ONLY user.
#
# Create the user on the same MariaDB server, granting SELECT only:
#   CREATE USER 'giveaway_ro'@'localhost' IDENTIFIED BY 'a_strong_password';
#   GRANT SELECT ON giveaway_bot.* TO 'giveaway_ro'@'localhost';
#   FLUSH PRIVILEGES;
#
# HOST/PORT fall back to DB_HOST/DB_PORT if omitted (same server).
GIVEAWAY_DB_HOST=localhost
GIVEAWAY_DB_PORT=3306
GIVEAWAY_DB_USER=giveaway_ro
GIVEAWAY_DB_PASSWORD='your_readonly_password'
GIVEAWAY_DB_NAME=giveaway_bot

# ── Ticket Bot Transcripts ────────────────────────────────────────────────────
# Absolute path on the server where transcript files are stored.
# This folder must be served by Apache2 under /transcripts
TRANSCRIPT_BASE_PATH=/var/www/html/transcripts

# ── Hosted Bot Configs ────────────────────────────────────────────────────────
# Absolute path on the server where hosted customer bots are stored.
# Each guild has its own subfolder: {BOT_CONFIG_BASE_PATH}/{guild_id}/
# The config files (config.jsonc, snippet.jsonc) are read/written by the dashboard.
# Apache2 must NOT serve this directory.
BOT_CONFIG_BASE_PATH=/opt/customer_ticketbots

# ── Bot Dashboard Reverse Proxy ───────────────────────────────────────────────
# msk-shop is the authenticated gateway in front of each hosted bot's own
# (loopback-bound) dashboard. Requests to BOT_DASHBOARD_HOST are forwarded to
# http://127.0.0.1:<ticketbot_guilds.bot_port>.
#
# BOT_DASHBOARD_PROXY_SECRET is the shared secret the bot trusts: it MUST equal
# DASHBOARD_TRUST_PROXY_SECRET in every hosted bot's .env. Long random value
# (>=32 chars). Empty = the proxy is disabled (the "Open bot dashboard" button
# returns 503).
BOT_DASHBOARD_PROXY_SECRET=
# Dedicated host the bot dashboards are served under (own DNS record + TLS cert).
BOT_DASHBOARD_HOST=bot-dashboard.msk-scripts.de
# Where to send a browser that arrives at the proxy without a valid session.
BOT_DASHBOARD_RETURN_URL=https://www.msk-scripts.de/ticketbot/dashboard

# Public IP of the server. Used both to validate a customer's custom-domain DNS
# record and as the content of the A record we create for a hosted bot's own
# dashboard subdomain.
SERVER_PUBLIC_IP=your.server.ip.here
# Optional. When set, an AAAA record is created alongside the A record. Leave it
# empty if the server does not actually answer on IPv6 — a AAAA pointing at a
# dead address is worse than no AAAA at all, because browsers try it first.
SERVER_PUBLIC_IPV6=

# ── IONOS DNS API (hosted bot subdomains) ─────────────────────────────────────
# msk-scripts.de has no wildcard DNS record, so every hosted bot's dashboard
# subdomain (tickets-<12 hex>.msk-scripts.de) needs an A/AAAA pair created here.
# No certificate run is involved: the zone already carries a wildcard cert.
#
# Key from https://developer.hosting.ionos.de/keys — it is sent as
# "X-API-Key: <prefix>.<secret>" and is valid for EVERY zone of the account,
# which is why lib/ionosDns.ts refuses to touch any name outside IONOS_DNS_ZONE.
# Both empty = subdomain automation is disabled.
IONOS_API_PREFIX=
IONOS_API_SECRET=
# The only zone this application may write DNS records in.
IONOS_DNS_ZONE=msk-scripts.de

# Admin email for Certbot SSL certificate notifications
ADMIN_EMAIL=your_admin_email

# ── Stripe (subscriptions) ────────────────────────────────────────────────────
# Premium / Premium+ subscriptions are billed via Stripe.
# Secret key:  https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxx
# Webhook signing secret for https://www.msk-scripts.de/api/webhook/stripe
# (Stripe → Developers → Webhooks). Events: checkout.session.completed,
# customer.subscription.created/updated/deleted/trial_will_end,
# invoice.payment_succeeded/failed
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Recurring price ids for the two paid tiers (Stripe → Products).
STRIPE_PRICE_PREMIUM=price_xxx
STRIPE_PRICE_PREMIUM_PLUS=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx

# ── Outgoing mail (SMTP) ──────────────────────────────────────────────────────
# Used for exactly one mail: the reminder three days before a free trial ends.
# The trial no longer collects a card, so without this mail a customer can lose
# Premium without ever being told. Leave it empty and the shop keeps working;
# the reminder is then skipped and only the dashboard notice remains.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=noreply@msk-scripts.de
SMTP_PASS=your_smtp_password
MAIL_FROM=MSK Scripts <noreply@msk-scripts.de>

# ── Discord OAuth App (Verify Flow) ───────────────────────────────────────────
# Create at: https://discord.com/developers/applications
# Redirect URLs (add BOTH to the OAuth app):
#   https://www.msk-scripts.de/api/auth/discord-verify/callback   (ticketbot dashboard)
#   https://www.msk-scripts.de/api/giveaway/auth/callback         (giveaway dashboard)
# Required scopes: identify guilds
DISCORD_VERIFY_CLIENT_ID=your_discord_oauth_client_id
DISCORD_VERIFY_CLIENT_SECRET=your_discord_oauth_client_secret

# ── Giveaway Web-Dashboard (bot control endpoint) ─────────────────────────────
# The giveaway bot exposes a localhost-only HTTP control endpoint. The dashboard
# proxies management actions to it. SECRET must match the bot's CONTROL_SECRET.
GIVEAWAY_CONTROL_URL=http://127.0.0.1:8787
GIVEAWAY_CONTROL_SECRET=must_match_bot_CONTROL_SECRET

# ── Giveaway public results pages ─────────────────────────────────────────────
# Shared secret the bot uses (Bearer) to push a giveaway's winners + entry count
# to /api/giveaway-result/publish. Must match the bot's RESULT_PUBLISH_SECRET.
GIVEAWAY_RESULT_SECRET=must_match_bot_RESULT_PUBLISH_SECRET

# ── Session Secret ──────────────────────────────────────────────────────────────
# Random string used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=your_random_session_secret_here

# ── Stats Ignored API Keys ───────────────────────────────────────────────────
STATS_IGNORED_API_KEYS=key1,key2,key3

# ── fivestats.io (Resource Statistics page /resources) ────────────────────────
# API key for https://fivestats.io — powers the live resource adoption stats.
# Server-side only (no NEXT_PUBLIC_ prefix) — never exposed to the client.
FIVESTATS_API_KEY=your_fivestats_api_key

# ── Admin Dashboard (/admin) ──────────────────────────────────────────────────
# Self-hosted Tebex admin dashboard. See docs/ADMIN_DASHBOARD_PLAN.md.
#
# Tebex Plugin API secret (game-server key) — grants full operational access
# (payments, coupons, gift cards, bans, package edits). SERVER-SIDE ONLY, never
# NEXT_PUBLIC_. Get it at: https://creator.tebex.io/game-servers → server → Edit.
TEBEX_PLUGIN_SECRET=your_tebex_plugin_secret
#
# Dedicated Discord OAuth app for the admin login (separate from the verify app).
# Scope: identify. Redirect URL to add to the OAuth app:
#   https://www.msk-scripts.de/api/admin/auth/callback
DISCORD_ADMIN_CLIENT_ID=your_admin_discord_oauth_client_id
DISCORD_ADMIN_CLIENT_SECRET=your_admin_discord_oauth_client_secret
#
# Your Discord user id — seeded as the owner (all permissions, non-revocable).
ADMIN_OWNER_DISCORD_ID=your_discord_user_id

# ── Bild-CDN (cdn.msk-scripts.de) ───────────────────────────────────────────
# Basis-URL, unter der die Bilder der Galerie ausgeliefert werden. Die App
# baut daraus alle CDN-Adressen (lib/images.ts); ein Umzug des Bestands auf
# ein Pull-CDN oder Object Storage ist damit eine Aenderung an dieser Zeile.
CDN_BASE_URL=https://cdn.msk-scripts.de
# Zielverzeichnis des Ingest-Scripts. Wird nur serverseitig von
# scripts/image-ingest.js und scripts/image-sync-check.js gelesen.
CDN_ROOT_PATH=/var/www/cdn.msk-scripts.de

# Quarantaene fuer Community-Uploads. MUSS ausserhalb jedes DocumentRoot liegen:
# hier landen eingereichte Bilder, bis ein Mensch sie freigibt. Nur der App-User
# darf hinein (chmod 700).
UPLOAD_INBOX_PATH=/var/lib/msk-image-uploads
