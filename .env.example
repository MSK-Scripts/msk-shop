# Tebex Headless API
NEXT_PUBLIC_TEBEX_PUBLIC_TOKEN=your_public_token
NEXT_PUBLIC_TEBEX_PROJECT_ID=your_project_id

# Private key — NEVER expose this in client-side code
TEBEX_PRIVATE_KEY=your_private_key

# Base URL
NEXT_PUBLIC_BASE_URL=https://www.msk-scripts.de

# ── Database (MariaDB/MySQL) ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# ── Ticket Bot Transcripts ────────────────────────────────────────────────────
# Absolute path on the server where transcript files are stored.
# This folder must be served by Apache2 under /transcripts
TRANSCRIPT_BASE_PATH=/var/www/html/transcripts

# ── GitHub Sponsors Webhook ───────────────────────────────────────────────────
# Set this as the webhook secret in GitHub → Settings → Sponsors → Webhooks
GITHUB_SPONSORS_WEBHOOK_SECRET=your_random_secret_here
